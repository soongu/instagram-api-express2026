generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 사람의 역할 — 이 컬럼에는 두 값 가운데 하나만 들어갈 수 있다.
enum Role {
  USER
  ADMIN

  @@map("user_role")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  email        String?   @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  name         String?   @db.VarChar(50)
  passwordHash String?   @map("password_hash")
  profileImage String?   @map("profile_image")
  deactivatedAt DateTime? @map("deactivated_at")
  role         Role      @default(USER)
  posts        Post[]
  comments     Comment[]
  likes        PostLike[]
  sessions     Session[]
  socialAccounts SocialAccount[]

  @@map("users")
}

model Post {
  id           Int       @id @default(autoincrement())
  authorId     Int       @map("author_id")
  author       User      @relation(fields: [authorId], references: [id])
  postAlt      String?   @map("post_alt")
  content      String?
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  comments     Comment[]
  images       PostImage[]
  likes        PostLike[]

  // 목록의 정렬과 같은 순서로 인덱스를 둔다 — 최신 글부터 정렬 없이 읽어 나갈 수 있다.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("posts")
}

// 여럿이 여럿을 가리키는 관계는 «가운데 테이블» 이 받는다.
// 한 행이 「누가 어느 게시물에 눌렀는가」 한 쌍이고, 같은 쌍은 한 번만 들어간다.
model PostLike {
  id     Int  @id @default(autoincrement())
  postId Int  @map("post_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostImage {
  id       Int    @id @default(autoincrement())
  postId   Int    @map("post_id")
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  imageUrl String @map("image_url")
  imgOrder Int    @map("img_order")

  @@map("post_images")
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int      @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  likeCount Int      @default(0) @map("like_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // 같은 테이블이 자기를 가리킨다 — 답글이 달린 «원댓글» 번호다.
  // 원댓글은 이 필드가 비어 있으므로 물음표가 붙는다.
  parentId Int?      @map("parent_id")
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  @@map("comments")
}

// 로그인 세션 — 쿠키에 담아 준 세션 ID 하나가 한 행이다.
// 사람을 지우면 그 사람의 세션도 함께 지운다(onDelete: Cascade).
// Refresh 토큰은 원문이 아니라 비밀값의 해시만 둔다 — 데이터베이스가 새어도 그 값으로는 새 토큰을 못 받는다.
// 새 토큰을 줄 때마다 바꾸기 전 해시를 «직전 해시»로 남긴다 — 그 값이 다시 오면 이미 쓴 토큰이 다시 온 것이다.
model Session {
  id                       String   @id
  userId                   Int      @map("user_id")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt                DateTime @map("expires_at")
  createdAt                DateTime @default(now()) @map("created_at")
  refreshTokenHash         String?  @map("refresh_token_hash")
  previousRefreshTokenHash String?  @map("previous_refresh_token_hash")

  @@index([userId])
  @@map("sessions")
}

// 소셜 계정 — «어느 제공자의 누구» 한 쌍이 한 행이고, 우리 사람 한 명을 가리킨다.
// 같은 쌍은 한 번만 들어간다 — 같은 구글 계정으로 다시 오면 이 행으로 그 사람을 찾는다.
// 사람을 지우면 그 사람의 소셜 계정도 함께 지운다(onDelete: Cascade).
model SocialAccount {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   @db.VarChar(20)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("social_accounts")
}

### jaehoon의 인가 코드 받기 (code_challenge를 담아)
# @no-redirect
POST http://127.0.0.1:4001/authorize
Content-Type: application/x-www-form-urlencoded

response_type=code&client_id=photo-app&redirect_uri=http://localhost:4002/callback&scope=photos&username=jaehoon&password=jaehoon1234&decision=allow&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256

### 로그인 — 기기 A
POST http://localhost:4003/login
Content-Type: application/json

{
  "userId": 2
}

### 로그인 — 기기 B
POST http://localhost:4003/login
Content-Type: application/json

{
  "userId": 2
}

### 기기 A로 나는 누구
# 기기 A 로그인 응답의 token 값으로 TOKEN_A 를 바꾼다
GET http://localhost:4003/me
Authorization: Bearer TOKEN_A

### 기기 A 로그아웃
POST http://localhost:4003/logout
Authorization: Bearer TOKEN_A

### 기기 B로 나는 누구
# 기기 B 로그인 응답의 token 값으로 TOKEN_B 를 바꾼다
GET http://localhost:4003/me
Authorization: Bearer TOKEN_B

### 토큰 없이 로그아웃
POST http://localhost:4003/logout

generator client {
  provider = "prisma-client-js"
  output   = "../generated-p2-33"   // 🚨 게이트 전용 — 공유 클라이언트(lab/generated)를 덮으면 p2-29~32 서점 실습이 깨진다
}

datasource db {
  provider = "postgresql"
}

model Author {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)
  books Book[]

  @@map("authors")
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  price     Int
  stock     Int      @default(0)
  authorId  Int?     @map("author_id")
  author    Author?  @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isSoldOut Boolean  @default(false) @map("is_sold_out")
  publisherId Int?       @map("publisher_id")
  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviews   Review[]

  @@map("books")
}

model Review {
  id        Int     @id @default(autoincrement())
  bookTitle String  @map("book_title") @db.VarChar(200)
  reviewer  String  @db.VarChar(100)
  score     Int
  comment   String?
  bookId    Int?    @map("book_id")
  book      Book?   @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("reviews")
}

model Publisher {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(100)
  foundedYear Int?   @map("founded_year")
  books       Book[]

  @@map("publishers")
}

# ~/instagram-api/.env.example
# 이 파일은 «이름만» 알려줘요. 값은 각자 자기 것을 .env에 적으세요.
DATABASE_URL=
CORS_ORIGIN=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SITE_URL=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 비워 두면 Access 토큰 기한은 15분이에요. 기한이 지난 뒤를 겪어 볼 때만 초를 적어요.
ACCESS_TOKEN_SECONDS=

# ~/instagram-api/.env.example
# 연습용 값이에요. 이 파일을 .env 로 복사해서 그대로 쓰면 서버가 켜져요.
#   macOS / Linux : cp .env.example .env
#   Windows       : Copy-Item .env.example .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instagram"
CORS_ORIGIN=http://localhost:3001
PORT=3000
# 로그인 토큰 서명 키 — 연습용이라 아무 문자열이나 돼요. 실제 서비스에서는 길고 무작위인 값으로 바꾸고 저장소에 올리지 않아요.
JWT_SECRET=dev-only-secret-change-me
SITE_URL=http://localhost:3001
# 소셜 로그인 키 — 비어 있으면 서버가 켜지지 않아서 dummy 를 채워 뒀어요.
# 소셜 로그인을 실제로 쓰려면 각 개발자 사이트에서 받은 진짜 값으로 바꾸세요(진짜 값은 저장소에 올리지 않아요).
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
KAKAO_CLIENT_ID=dummy
KAKAO_CLIENT_SECRET=dummy
NAVER_CLIENT_ID=dummy
NAVER_CLIENT_SECRET=dummy

# 소셜로 로그인한 브라우저의 accessToken 쿠키 값을 복사해 아래 COPIED_TOKEN 자리에 넣는다
@token = COPIED_TOKEN

### 내 로그인 방법
# @no-cookie-jar
GET http://localhost:3000/api/v2/auth/social-accounts
Authorization: Bearer {{token}}

### 카카오 연결 끊기
# @no-cookie-jar
DELETE http://localhost:3000/api/v2/auth/social-accounts/kakao
Authorization: Bearer {{token}}

### 이어지지 않은 네이버 끊기
# @no-cookie-jar
DELETE http://localhost:3000/api/v2/auth/social-accounts/naver
Authorization: Bearer {{token}}

### 다시 내 로그인 방법
# @no-cookie-jar
GET http://localhost:3000/api/v2/auth/social-accounts
Authorization: Bearer {{token}}
